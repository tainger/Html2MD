{
  "manifest_version": 3,
  "name": "Html2MD 网页转 Markdown",
  "version": "1.0.0",
  "description": "一键将当前网页文档转换为 Markdown，支持智能正文提取、选中区域转换、复制与下载 .md 文件。",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "转换为 Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
